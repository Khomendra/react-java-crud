# ─────────────────────────────────────────────────────────────
# EMS environment variables
# Copy this file to .env and fill in real values.
# .env is git-ignored. NEVER commit real passwords or secrets.
# ─────────────────────────────────────────────────────────────

# ── Database (backend) ──
DB_URL=jdbc:postgresql://localhost:5432/ems
DB_USERNAME=ems_app
DB_PASSWORD=change-me

# ── JWT (backend) ──
# Generate one: openssl rand -base64 64   (or see README)
JWT_SECRET=replace-with-at-least-64-random-base64-characters
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
JWT_ISSUER=ems-api

# ── Web / security (backend) ──
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# ── File uploads (backend) ──
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_SIZE=2MB

# ── First admin account, created on first startup only ──
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@ems.local
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-strong-password

# ── Frontend (anything VITE_* ends up PUBLIC in the browser bundle) ──
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ── Docker Compose (Phase 14) ──
POSTGRES_DB=ems
POSTGRES_USER=ems_app
POSTGRES_PASSWORD=change-me
